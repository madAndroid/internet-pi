# {{ ansible_managed }}
---
services:
  atuin:
    container_name: atuin
    restart: always
    image: ghcr.io/atuinsh/atuin:{{ atuin_image_tag }}
    command: start
    volumes:
      - "./config:/config"
    ports:
      # Localhost only - TLS is terminated by HAProxy (atuin.int.stangl.co.za).
      - "127.0.0.1:{{ atuin_port }}:8888"
    environment:
      ATUIN_HOST: "0.0.0.0"
      ATUIN_OPEN_REGISTRATION: "{{ atuin_open_registration | lower }}"
      # Database lives on the consolidated `postgres` instance (shared pg-net network).
      ATUIN_DB_URI: "postgres://${ATUIN_DB_USERNAME}:${ATUIN_DB_PASSWORD}@postgres/${ATUIN_DB_NAME}"
      RUST_LOG: info,atuin_server=debug
    networks:
      - pg-net

networks:
  pg-net:
    name: pg-net
    external: true
