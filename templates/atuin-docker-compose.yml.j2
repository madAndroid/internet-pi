# {{ ansible_managed }}
---
services:
  atuin:
    container_name: atuin
    restart: always
    image: ghcr.io/atuinsh/atuin:{{ atuin_image_tag }}
    command: start
    volumes:
      - "./config:/config"
    ports:
      # Localhost only - TLS is terminated by HAProxy (atuin.int.stangl.co.za).
      - "127.0.0.1:{{ atuin_port }}:8888"
    environment:
      ATUIN_HOST: "0.0.0.0"
      ATUIN_OPEN_REGISTRATION: "{{ atuin_open_registration | lower }}"
      ATUIN_DB_URI: "postgres://${ATUIN_DB_USERNAME}:${ATUIN_DB_PASSWORD}@db/${ATUIN_DB_NAME}"
      RUST_LOG: info,atuin_server=debug
    depends_on:
      - db

  db:
    container_name: atuin-db
    image: postgres:{{ atuin_postgres_image_tag }}
    restart: unless-stopped
    volumes:
      # Don't remove this volume - it holds all synced history.
      - "./database:/var/lib/postgresql/"
    environment:
      POSTGRES_USER: ${ATUIN_DB_USERNAME}
      POSTGRES_PASSWORD: ${ATUIN_DB_PASSWORD}
      POSTGRES_DB: ${ATUIN_DB_NAME}
      TZ: {{ atuin_timezone }}
      PGTZ: {{ atuin_timezone }}

  backup:
    container_name: atuin-db-dumper
    image: prodrigestivill/postgres-backup-local:{{ atuin_backup_image_tag }}
    restart: unless-stopped
    env_file:
      - .env
    environment:
      POSTGRES_HOST: db
      POSTGRES_DB: ${ATUIN_DB_NAME}
      POSTGRES_USER: ${ATUIN_DB_USERNAME}
      POSTGRES_PASSWORD: ${ATUIN_DB_PASSWORD}
      SCHEDULE: "@daily"
      BACKUP_DIR: /db_dumps
      TZ: {{ atuin_timezone }}
    volumes:
      - "./db_dumps:/db_dumps"
    depends_on:
      - db
